{
  "name": "fabsim3d",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "교육용 반도체 공정 시뮬레이터 — 기하 연산자 기반 샌드박스",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "smoke": "node scripts/smoke.mjs",
    "smoke:narrow": "node scripts/mobileshot.mjs",
    "latency": "node scripts/latency.mjs",
    "serve:dist": "node scripts/serve-dist.mjs dist 5200"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
